   price : String, images : ArrayList<String>, location : String, gearType : String,
    fuelType : String, color : String, doors : String, seats : String, sunroof : String,
     disabledCar : String, testDate : String, year : String, horsePower : String,
      engineCapacity : String, ownerId : String)
  + getType() : String
  + getModel() : String
  + getTrim() : String
