}

class Message {
  - senderId : String
  - text : String
  - timestamp : Timestamp
  ~ Message()
  ~ Message(senderId : String, text : String, timestamp : Timestamp)
  + getSenderId() : String
  + getText() : String
  + getTimestamp() : Timestamp
}

class ChatItem {
  + chatId : String
  + otherUserId : String
  + otherUserName : String
  + otherUserImage : String
